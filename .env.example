# ---------------------------------------------------------------------------
# AGI Aeronautics - environment variables
# Copy this file to .env for local development.
# In production, set these as Railway or Cloudflare variables.
# On Cloudflare, DATABASE_URL must be the public Postgres address.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for Railway and local development.
# Cloudflare does not use this. The Cloudflare site uses D1 database
# database_agi_aeronautics, attached in wrangler.jsonc.
DATABASE_URL="postgresql://user:password@localhost:5432/agi_aeronautics"

# Shown on the Cloudflare Worker as a plain variable. Railway ignores it.
CLOUDFLARE_D1_DATABASE_ID="2bed0fdb-1b38-453f-be5b-cc9a26aa44be"

# OpenAI API key used for embeddings (knowledge base) and chat completions.
OPENAI_API_KEY="sk-..."

# Random long secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Bootstrap credentials for the single Admin account. On every deploy, a user
# with this email/password is created (or updated) as the super admin. Use
# this account to log in and access /admin - it is hidden from all other users.
ADMIN_NAME="AGI Administrator"
ADMIN_EMAIL="admin@agiaeronautics.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional: public site URL, used for metadata/links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gmail outreach. GMAIL_APP_PASSWORD is a Google app password, not the account password.
GMAIL_USER="office@agi-aeronautics.com"
GMAIL_APP_PASSWORD=""
