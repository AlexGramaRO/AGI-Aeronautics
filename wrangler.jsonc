{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agi-aeronautics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agi-aeronautics"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database_agi_aeronautics",
      "database_id": "2bed0fdb-1b38-453f-be5b-cc9a26aa44be"
    }
  ],
  "vars": {
    "CLOUDFLARE_D1_DATABASE_ID": "2bed0fdb-1b38-453f-be5b-cc9a26aa44be"
  }
}
