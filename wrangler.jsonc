{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agi-aeronautics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "secrets": {
    "required": [
      "JWT_SECRET",
      "OPENAI_API_KEY",
      "ADMIN_PASSWORD",
      "GMAIL_APP_PASSWORD",
      "ADMIN_EMAIL",
      "ADMIN_NAME",
      "GMAIL_USER",
      "NEXT_PUBLIC_SITE_URL"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agi-aeronautics"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database_agi_aeronautics",
      "database_id": "2bed0fdb-1b38-453f-be5b-cc9a26aa44be"
    }
  ]
}
